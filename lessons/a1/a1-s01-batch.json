well"},"correct":false}]},{"id":"ex09","type":"reading_comprehension","skill":["reading"],"instruction":{"ru":"Прочитай и определи форму.","uk":"Прочитай і визнач форму.","en":"Read and identify the form."},"text":{"sk":"Ahoj, Lucia! Ako sa voláš? — Volám sa Eva."},"questions":[{"question":{"ru":"Какой тип обращения используется?","uk":"Який тип звертання використано?","en":"What type of address is used?"},"options":[{"id":"a","sk":"ty","correct":true},{"id":"b","sk":"vy","correct":false},{"id":"c","sk":"pani","correct":false}]}]},{"id":"ex10","type":"natural_phrase","skill":["dialogue","real_life"],"instruction":{"ru":"Выбери подходящую фразу.","uk":"Обери доречну фразу.","en":"Choose the appropriate phrase."},"situation":{"ru":"Ты впервые обращаешься к незнакомой взрослой женщине.","uk":"Ти вперше звертаєшся до незнайомої дорослої жінки.","en":"You are speaking to an unfamiliar adult woman for the first time."},"options":[{"id":"a","sk":"Dobrý deň, pani Nováková. Ako sa voláte?","correct":true},{"id":"b","sk":"Ahoj, ako sa voláš?","correct":false}]}],"finalSituation":{"title":{"ru":"Выбор обращения","uk":"Вибір звертання","en":"Choosing the address form"},"steps":[{"id":"step1","instruction":{"ru":"Обратись к другу неформально.","uk":"Звернися до друга неформально.","en":"Address a friend informally."},"expected":{"sk":"Ako sa voláš?"}},{"id":"step2","instruction":{"ru":"Обратись к незнакомому взрослому вежливо.","uk":"Звернися до незнайомого дорослого ввічливо.","en":"Address an unfamiliar adult politely."},"expected":{"sk":"Ako sa voláte?"}},{"id":"step3","instruction":{"ru":"Добавь вежливое приветствие.","uk":"Додай ввічливе привітання.","en":"Add a polite greeting."},"expected":{"sk":"Dobrý deň!"}}],"passRequirement":"3/3"}}]}
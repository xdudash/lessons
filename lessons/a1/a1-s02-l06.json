{"lessons":[{"id":"a1-s02-l06","sectionId":"a1-s02","level":"A1","title":{"sk":"Meno, vek, národnosť, adresa a telefón","ru":"Имя, возраст, национальность, адрес и телефон","uk":"Ім’я, вік, національність, адреса й телефон","en":"Name, age, nationality, address and phone"},"description":{"ru":"Собрать базовые личные данные в коротком обмене информацией.","uk":"Зібрати базові особисті дані в короткому обміні інформацією.","en":"Use basic personal information in a short exchange."},"topic":{"sk":"Osobné údaje","ru":"Личные данные","uk":"Особисті дані","en":"Personal data"},"order":6,"xpReward":100,"estimatedMinutes":24,"isPublished":false,"intro":{"ru":"Научись дать несколько основных сведений о себе и понять такие сведения о другом человеке.","uk":"Навчися називати кілька основних відомостей про себе й розуміти такі відомості про іншу людину.","en":"Learn to give several basic facts about yourself and understand them about another person."},"completionMessage":{"ru":"Урок завершён. Повтори задания, в которых были ошибки.","uk":"Урок завершено. Повтори завдання, у яких були помилки.","en":"Lesson complete. Revisit the exercises you found difficult."},"updatedAt":"2026-09-12T08:00:00Z","localization":{"uiLanguages":["uk","ru","en"],"targetLanguage":"sk","fallbackUiLanguage":"uk"},"assets":{"images":{},"audio":{}},"startScreen":{"screenType":"lesson_start","eyebrow":{"uk":"A1 • Розділ 2","ru":"A1 • Раздел 2","en":"A1 • Section 2"},"title":{"sk":"Meno, vek, národnosť, adresa a telefón","uk":"Ім’я, вік, національність, адреса й телефон","ru":"Имя, возраст, национальность, адрес и телефон","en":"Name, age, nationality, address and phone"},"goal":{"uk":"Називати та запитувати базові особисті дані","ru":"Называть и спрашивать базовые личные данные","en":"Give and ask for basic personal data"},"estimatedMinutes":24},"theoryScreens":[{"id":"theory-1","screenType":"theory","order":1,"title":{"uk":"Základné osobné údaje","ru":"Основные личные данные","en":"Basic personal data"},
abulary"],"instruction":{"ru":"Выберите фразу о занятии.","uk":"Оберіть фразу про заняття.","en":"Choose the phrase about an activity."},"prompt":{"sk":"Я люблю читать."},"options":[{"id":"a","sk":"Rád čítam.","correct":true},{"id":"b","sk":"Mám 30 rokov.","correct":false},{"id":"c","sk":"Som z Nitry.","correct":false}]},{"id":"ex02","type":"matching","skill":["vocabulary"],"instruction":{"ru":"Соедините форму и значение.","uk":"З’єднайте форму та значення.","en":"Match the form and meaning."},"pairs":[{"left":{"sk":"čítam"},"right":{"ru":"читаю","uk":"читаю","en":"I read"}},{"left":{"sk":"počúvam"},"right":{"ru":"слушаю","uk":"слухаю","en":"I listen"}},{"left":{"sk":"športujem"},"right":{"ru":"занимаюсь спортом","uk":"займаюся спортом","en":"I do sport"}},{"left":{"sk":"cestujem"},"right":{"ru":"путешествую","uk":"подорожую","en":"I travel"}}]},{"id":"ex03","type":"multiple_select","skill":["vocabulary"],"instruction":{"ru":"Выберите фразы о любимых занятиях.","uk":"Оберіть фрази про улюблені заняття.","en":"Choose phrases about favourite activities."},"options":[{"id":"a","sk":"Rád čítam.","correct":true},{"id":"b","sk":"Rada cestujem.","correct":true},{"id":"c","sk":"Koľko máš rokov?","correct":false},{"id":"d","sk":"Kde bývaš?","correct":false}]},{"id":"ex04","type":"dropdown_blank","skill":["grammar"],"instruction":{"ru":"Выберите форму для мужчины.","uk":"Оберіть форму для чоловіка.","en":"Choose the form for a male speaker."},"sentenceParts":[{"text":""},{"blankId":"b1","options":["Rád","Rada","Radu"],"correct":"Rád"},{"text":" čítam."}]},{"id":"ex05","type":"fill_blank","skill":["writing"],"instruction":{"ru":"Впишите глагол.","uk":"Впишіть дієслово.","en":"Write the verb."},"sentence":{"sk":"Rád ___ hudbu."},"acceptedAnswers":["počúvam"]},{"id":"ex06","type":"sentence_builder","skill":["writing"],"instruction":{"ru":"Соберите предложение.","uk":"Складіть речення.","en":"Build the sentence."},"tokens":["Rád","čítam","."],"correctSentence":"Rád čítam."},{"id"
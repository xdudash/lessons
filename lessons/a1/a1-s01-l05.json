:{"sk":"Vy ___ pani učiteľka."},"acceptedAnswers":["ste"],"hint":{"ru":"С vy используем ste.","uk":"З vy вживаємо ste.","en":"With vy, use ste."}}],"finalSituation":{"id":"final-situation","type":"interactive_scenario","title":{"ru":"Применяем в разговоре","uk":"Застосовуємо в розмові","en":"Use it in conversation"},"description":{"ru":"Соединить знакомые модели в первом контакте","uk":"Поєднати знайомі моделі під час першого контакту","en":"Combine familiar models in a first contact"},"steps":[{"id":"step-1","prompt":{"sk":"Stretneš novú dospelú osobu."},"options":[{"id":"a","sk":"Dobrý deň!","correct":true},{"id":"b","sk":"Ahoj!","correct":false}]},{"id":"step-2","prompt":{"sk":"Predstavíš sa."},"options":[{"id":"a","sk":"Volám sa Tomáš.","correct":true},{"id":"b","sk":"Vy ste Tomáš.","correct":false}]},{"id":"step-3","prompt":{"sk":"Osoba ti podá pero."},"options":[{"id":"a","sk":"Ďakujem pekne.","correct":true},{"id":"b","sk":"Prosím, pero.","correct":false}]}],"passRequirement":"3/3"},"resultScreen":{"title":{"ru":"Готово","uk":"Готово","en":"Done"},"body":{"ru":"Ты проверил, умеешь ли соединять знакомые модели первого контакта.","uk":"Ти перевірив, чи вмієш поєднувати знайомі моделі першого контакту.","en":"You checked whether you can combine familiar first-contact models."}}}]}
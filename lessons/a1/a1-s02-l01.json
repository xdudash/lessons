o si?"}],"options":[{"id":"a","sk":"Som študent.","correct":true},{"id":"b","sk":"Som z Ukrajiny.","correct":false},{"id":"c","sk":"Volám sa Peter.","correct":false}]},{"id":"ex09","type":"correct_error","skill":["grammar","writing"],"instruction":{"ru":"Исправь форму byť.","uk":"Виправ форму byť.","en":"Correct the form of byť."},"sentence":{"sk":"Ja si učiteľ."},"acceptedAnswers":["Ja som učiteľ."]},{"id":"ex10","type":"reading_comprehension","skill":["reading"],"instruction":{"ru":"Прочитай профиль и ответь.","uk":"Прочитай профіль і дай відповідь.","en":"Read the profile and answer."},"text":{"sk":"Ahoj! Som Peter. Som študent. Som z Ukrajiny."},"questions":[{"question":{"ru":"Кто Peter?","uk":"Хто Peter?","en":"What is Peter?"},"options":[{"id":"a","sk":"Študent.","correct":true},{"id":"b","sk":"Učiteľ.","correct":false},{"id":"c","sk":"Lekár.","correct":false}]}]},{"id":"ex11","type":"meaning_in_context","skill":["reading","vocabulary"],"instruction":{"ru":"Выбери значение.","uk":"Обери значення.","en":"Choose the meaning."},"context":{"sk":"Som učiteľ."},"target":{"sk":"Som učiteľ."},"options":[{"id":"a","text":{"ru":"Я учитель.","uk":"Я вчитель.","en":"I am a teacher."},"correct":true},{"id":"b","text":{"ru":"Ты учитель.","uk":"Ти вчитель.","en":"You are a teacher."}},{"id":"c","text":{"ru":"Он учитель.","uk":"Він учитель.","en":"He is a teacher."}}]},{"id":"ex12","type":"natural_phrase","skill":["dialogue","real_life"],"instruction":{"ru":"Выбери естественное начало рассказа о себе.","uk":"Обери природний початок розповіді про себе.","en":"Choose a natural start to a self-introduction."},"situation":{"ru":"Тебя просят кратко представиться.","uk":"Тебе просять коротко представитися.","en":"You are asked to introduce yourself briefly."},"options":[{"id":"a","sk":"Som Peter.","correct":true},{"id":"b","sk":"Si Peter.","correct":false},{"id":"c","sk":"Je Peter.","correct":false}]},{"id":"ex13","type":"dialogue_choose_reply","skill":["dialogue","reading"],"instr
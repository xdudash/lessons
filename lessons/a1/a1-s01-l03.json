?"},"correct":false}]},{"id":"ex12","type":"natural_phrase","skill":["dialogue","real_life"],"instruction":{"ru":"Выбери естественный ответ о стране.","uk":"Обери природну відповідь про країну.","en":"Choose a natural answer about a country."},"situation":{"ru":"Собеседник спрашивает, откуда ты.","uk":"Співрозмовник запитує, звідки ти.","en":"Someone asks where you are from."},"options":[{"id":"a","sk":"Som z Ukrajiny.","correct":true},{"id":"b","sk":"Ako sa voláš?","correct":false},{"id":"c","sk":"Dovidenia.","correct":false}]},{"id":"ex13","type":"dialogue_choose_reply","skill":["dialogue","reading"],"instruction":{"ru":"Продолжи знакомство.","uk":"Продовж знайомство.","en":"Continue the introduction."},"dialogue":[{"speaker":"A","sk":"Ahoj! Odkiaľ si?"},{"speaker":"B","sk":"Som z Ukrajiny."}],"options":[{"id":"a","sk":"Teší ma!","correct":true},{"id":"b","sk":"Ako sa volám?","correct":false},{"id":"c","sk":"Odkiaľ si?","correct":false}]},{"id":"ex14","type":"fill_blank","skill":["writing","vocabulary"],"instruction":{"ru":"Впиши форму страны в готовую модель.","uk":"Встав форму назви країни в готову модель.","en":"Insert the country form into the ready pattern."},"sentence":{"sk":"Som zo _____."},"acceptedAnswers":["Slovenska"],"hint":{"ru":"После zo здесь нужна форма Slovenska.","uk":"Після zo тут потрібна форма Slovenska.","en":"After zo, use the form Slovenska here."}},{"id":"ex15","type":"single_choice","skill":["real_life","dialogue"],"instruction":{"ru":"Выбери подходящую реплику.","uk":"Обери доречну репліку.","en":"Choose the appropriate line."},"prompt":{"ru":"A: Odkiaľ si?","uk":"A: Odkiaľ si?","en":"A: Odkiaľ si?"},"options":[{"id":"a","sk":"Som zo Slovenska.","correct":true},{"id":"b","sk":"Volám sa Jana.","correct":false},{"id":"c","sk":"Dobré ráno.","correct":false}]},{"id":"ex16","type":"sentence_builder","skill":["writing","dialogue"],"instruction":{"ru":"Собери мини-обмен.","uk":"Склади міні-обмін.","en":"Build the mini-exchange."},"tokens":["Odkiaľ","si?","Som","z","Ukrajiny."],"correctSentence":"Odkiaľ si? Som z Ukrajiny."}],"finalSituation":{"title":{"ru":"Новое знакомство","uk":"Нове знайомство","en":"A new acquaintance"},"steps":[{"id":"step1","instruction":{"ru":"Спроси, откуда собеседник.","uk":"Запитай, звідки співрозмовник.","en":"Ask where the person is from."},"expected":{"sk":"Odkiaľ si?"}},{"id":"step2","instruction":{"ru":"Скажи, что ты из Словакии.","uk":"Скажи, що ти зі Словаччини.","en":"Say you are from Slovakia."},"expected":{"sk":"Som zo Slovenska."}},{"id":"step3","instruction":{"ru":"Скажи, что ты из Украины.","uk":"Скажи, що ти з України.","en":"Say that you are from Ukraine."},"expected":{"sk":"Som z Ukrajiny."}}]},"resultScreen":{"title":{"ru":"Готово!","uk":"Готово!","en":"Done!"},"body":{"ru":"Ты умеешь спросить, откуда человек, и назвать страну.","uk":"Ти вмієш запитати, звідки людина, і назвати країну.","en":"You can ask where someone is from and name a country."}}}]}